NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://postbird:postbird@localhost:5432/postbird
JWT_SECRET=replace-with-at-least-32-characters
ENCRYPTION_KEY=replace-with-at-least-32-characters
UPLOAD_DIR=./uploads
FRONTEND_URL=http://localhost:5173
API_URL=http://localhost:4000
VITE_API_URL=/api

SMTP_HOST=smtp.provider.com(smtp.gmail.com, smtp.office365.com, etc.)
SMTP_PORT=587(587, 465, etc.)
SMTP_USER=you@provider.com(your-email@gmail.com, your-email@office365.com, etc.)
SMTP_PASSWORD=your-app-password(your-app-password, your-app-password, etc.)
SMTP_SECURITY=STARTTLS(STARTTLS, SSL/TLS, etc.)
