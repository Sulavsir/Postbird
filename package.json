{
  "name": "smtp-task",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite --config apps/web/vite.config.ts",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "dev:api": "tsx --tsconfig apps/api/tsconfig.json apps/api/src/server.ts",
    "build": "npm run build:web && npm run build:api",
    "build:web": "tsc -p apps/web/tsconfig.json && vite build --config apps/web/vite.config.ts",
    "build:api": "tsc -p apps/api/tsconfig.json",
    "db:generate": "prisma generate --schema apps/api/prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema apps/api/prisma/schema.prisma",
    "db:seed": "tsx apps/api/prisma/seed.ts",
    "lint": "oxlint",
    "preview": "vite preview --config apps/web/vite.config.ts"
  },
  "dependencies": {
    "@postbird/shared": "file:packages/shared",
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.4.0",
    "@prisma/client": "^6.19.2",
    "@tanstack/react-query": "^5.90.16",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "imapflow": "^1.2.11",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^1.47.0",
    "nodemailer": "^7.0.6",
    "multer": "^2.0.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.71.1",
    "react-router-dom": "^7.9.6",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@tailwindcss/vite": "^4.1.13",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.1.13",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/nodemailer": "^7.0.3",
    "oxlint": "^1.81.0",
    "prisma": "^6.19.2",
    "tsx": "^4.21.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
